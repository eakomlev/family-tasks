POSTGRES_USER=family
POSTGRES_PASSWORD=change-me
POSTGRES_DB=family_tasks
WEB_PORT=8080

# Письма отправляет сервис notifier. В Docker они уходят в Mailpit (http://localhost:8025 при запуске с dev-override).
# Профиль dev-mail запускает Mailpit вместе с остальными сервисами. В проде уберите его и задайте SMTP:
COMPOSE_PROFILES=dev-mail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Моя Семья <noreply@example.com>"

# Для локального запуска сервера и сервиса отправки (npm run dev)
DATABASE_URL=postgres://family:change-me@localhost:5432/family_tasks

# Web Push (уведомления о днях рождения и уроках). Ключи создаёт команда `npm run vapid` в notifier/;
# пару нужно сгенерировать один раз и не менять: после смены ключей все подписки перестанут работать.
# Публичный ключ нужен и серверу (его просит браузер), приватный и VAPID_SUBJECT только сервису notifier.
# VAPID_SUBJECT: ваш контакт в формате mailto:you@example.com (push-сервисы могут отклонять выдуманные адреса).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Письма и push идут через очередь (таблица outbox), их отправляет отдельный сервис notifier: повторы, ограничение
# нагрузки (docs/notification-queue-plan.md). Если notifier не запущен, письма и push копятся в очереди и не уходят.
# Прежняя переменная QUEUE_ENABLED больше не используется: очередь включена всегда.
# Лимиты сервиса отправки (notifier). MAIL_DAILY_LIMIT: писем в сутки (сутки по UTC), поставьте чуть меньше лимита
# почтового сервиса (например, 2800 при его 3000); 0 отключает дневной лимит (удобно для разработки с Mailpit).
# Скорость в секунду считается на один экземпляр notifier: если их несколько, разделите её между ними.
# MAIL_DAILY_LIMIT=2800
# MAIL_RATE_PER_SECOND=2
# PUSH_RATE_PER_SECOND=50

# Администраторы сервиса: email через запятую. Им в профиле доступен раздел «Сервис» со статистикой (аккаунты, сообщения).
# Пусто: раздела нет ни у кого.
ADMIN_EMAILS=

# --- Продакшен (docker-compose.prod.yml), подробности в README, раздел «Деплой на сервер» ---
# На сервере удобно подключить продакшен-конфигурацию через .env, тогда команды короткие (docker compose up -d --build):
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Домен, направленный на сервер: для него Caddy получит HTTPS-сертификат.
# DOMAIN=family.example.com
