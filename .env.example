POSTGRES_USER=family
POSTGRES_PASSWORD=change-me
POSTGRES_DB=family_tasks
WEB_PORT=8080

# Письма отправляет сервис notifier. В Docker они уходят в Mailpit (http://localhost:8025 при запуске с dev-override).
# Профиль dev-mail запускает Mailpit вместе с остальными сервисами. В проде уберите его и задайте SMTP:
COMPOSE_PROFILES=dev-mail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Моя Семья <noreply@example.com>"

# Для локального запуска сервера и сервиса отправки (npm run dev)
DATABASE_URL=postgres://family:change-me@localhost:5432/family_tasks

# Web Push (уведомления о днях рождения и уроках). Ключи создаёт команда `npm run vapid` в notifier/;
# пару нужно сгенерировать один раз и не менять: после смены ключей все подписки перестанут работать.
# Публичный ключ нужен и серверу (его просит браузер), приватный и VAPID_SUBJECT только сервису notifier.
# VAPID_SUBJECT: ваш контакт в формате mailto:you@example.com (push-сервисы могут отклонять выдуманные адреса).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Push в мобильное приложение на Android (Firebase Cloud Messaging). FCM_ENABLED=true включает регистрацию устройств и постановку
# уведомлений в очередь (нужно server, scheduler и notifier), а FCM_SERVICE_ACCOUNT_BASE64 нужен только notifier: закрытый ключ
# сервисного аккаунта Firebase (Настройки проекта → Сервисные аккаунты → Создать закрытый ключ), JSON одной строкой base64:
#   base64 -w0 service-account.json     (в PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")))
# Ключ секретный: в репозиторий его не добавляйте.
FCM_ENABLED=
FCM_SERVICE_ACCOUNT_BASE64=

# Push на iPhone (Apple Push Notification service). APNS_ENABLED=true включает регистрацию устройств и постановку уведомлений в очередь
# (нужно server, scheduler и notifier), остальное нужно только notifier. Ключ создаётся в Apple Developer: Certificates, Identifiers & Profiles
# → Keys → «+» → Apple Push Notifications service (APNs), файл .p8 скачивается один раз:
#   base64 -w0 AuthKey_XXXXXXXXXX.p8     (в PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("AuthKey_XXXXXXXXXX.p8")))
# APNS_KEY_ID: десять знаков из имени файла, APNS_TEAM_ID: Team ID (Membership). APNS_PRODUCTION=true для TestFlight и App Store
# (false только для сборок, запущенных из Xcode на своём телефоне). Ключ секретный: в репозиторий его не добавляйте.
APNS_ENABLED=
APNS_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=ru.familytasks.mobile
APNS_PRODUCTION=true

# Письма и push идут через очередь (таблица outbox), их отправляет отдельный сервис notifier: повторы, ограничение
# нагрузки (docs/notification-queue-plan.md). Если notifier не запущен, письма и push копятся в очереди и не уходят.
# Прежняя переменная QUEUE_ENABLED больше не используется: очередь включена всегда.
# Лимиты сервиса отправки (notifier). MAIL_DAILY_LIMIT: писем в сутки (сутки по UTC), поставьте чуть меньше лимита
# почтового сервиса (например, 2800 при его 3000); 0 отключает дневной лимит (удобно для разработки с Mailpit).
# Скорость в секунду считается на один экземпляр notifier: если их несколько, разделите её между ними.
# MAIL_DAILY_LIMIT=2800
# MAIL_RATE_PER_SECOND=2
# PUSH_RATE_PER_SECOND=50

# Фото в чатах: сервис media хранит их в S3-совместимом хранилище (контейнер s3). Секреты задайте свои (например, openssl rand -hex 32)
# и не меняйте после запуска: MEDIA_SECRET подписывает ссылки на фото (после смены старые ссылки перестанут открываться),
# MEDIA_INTERNAL_TOKEN защищает внутренний вызов server -> media. Ключи S3 с этих значений создают хранилище при запуске.
MEDIA_SECRET=change-me-media-secret
MEDIA_INTERNAL_TOKEN=change-me-media-token
# Адрес хранилища для локального запуска media (npm run dev); в Docker сервис media ходит к контейнеру s3 сам
S3_ENDPOINT=http://localhost:8333
# Адрес media для локального запуска server (npm run dev); локально media слушает порт 3001. В Docker server берёт http://media:3000 сам
MEDIA_URL=http://localhost:3001
# S3_ACCESS_KEY=mediakey
# S3_SECRET_KEY=mediasecret
# S3_BUCKET=media
# Внешнее S3-хранилище вместо контейнера s3 (пример: рег.ру). Задайте адрес, ключи из кабинета и свой бакет (приватный);
# контейнер s3 после этого не нужен (docker compose stop s3). Регион можно оставить пустым.
# S3_REMOTE_ENDPOINT=https://s3.regru.cloud
# S3_REGION=
# S3_FORCE_PATH_STYLE=true
# Квота фото на одну семью, байт (по умолчанию 2 ГБ)
# MEDIA_QUOTA_BYTES=2147483648
# Файлы в чатах (документы, архивы): предел одного файла в байтах (по умолчанию 50 МБ; в nginx для загрузки тело до 51 МБ).
# MAX_FILE_BYTES=52428800
# Видео в чатах: предел загрузки в байтах (по умолчанию 100 МБ; в nginx для загрузки тело до 101 МБ) и длительность в секундах (по умолчанию 180).
# Сервис media сжимает видео (ffmpeg), поэтому на слабом сервере долгая обработка нагружает процессор.
# MAX_VIDEO_BYTES=104857600
# MAX_VIDEO_SECONDS=180

# Администраторы сервиса: email через запятую. Им в профиле доступен раздел «Сервис» со статистикой (аккаунты, сообщения).
# Пусто: раздела нет ни у кого.
ADMIN_EMAILS=

# Яндекс SmartCaptcha перед отправкой кода на почту (https://yandex.cloud/ru/services/smartcaptcha): капча-невидимка в кабинете
# Yandex Cloud, разрешённый домен — адрес сайта. Нужны оба ключа (ключ клиента и ключ сервера); пусто: капчи нет (разработка).
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# --- Продакшен (docker-compose.prod.yml), подробности в README, раздел «Деплой на сервер» ---
# На сервере удобно подключить продакшен-конфигурацию через .env, тогда команды короткие (docker compose up -d --build):
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Домен, направленный на сервер: для него Caddy получит HTTPS-сертификат.
# DOMAIN=family.example.com
