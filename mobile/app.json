{
  "expo": {
    "name": "Моя Семья",
    "slug": "family-tasks",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "familytasks",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.familytasks.mobile",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ru.familytasks.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#10133a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10133a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "./plugins/withReleaseSigning",
      "@react-native-community/datetimepicker",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "image/*",
              "*/*"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "*/*"
            ]
          },
          "ios": {
            "enabled": false,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsFileWithMaxCount": 5
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10133a",
          "mode": "production"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Нужен доступ к контактам, чтобы вы могли пригласить человека по его email."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Нужен доступ к фотографиям, чтобы вы могли отправлять фото в чат и выбирать аватар.",
          "cameraPermission": "Нужен доступ к камере, чтобы вы могли снять фото для чата.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
